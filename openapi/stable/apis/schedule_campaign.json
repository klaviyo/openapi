    "schemas": {
      "AgentHints": {
        "description": "Optional hints emitted by the API for agent callers",
        "type": "object",
        "properties": {
          "next_steps": {
            "description": "Suggested follow-up actions for agents to take after this response",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CampaignEnum": {
        "type": "string",
        "enum": [
          "campaign"
        ]
      },
      "CampaignScheduleEnum": {
        "type": "string",
        "enum": [
          "campaign-schedule"
        ]
      },
      "CampaignScheduleQuery": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CampaignScheduleQueryResourceObject"
          }
        },
        "required": [
          "data"
        ]
      },
      "CampaignScheduleQueryResourceObject": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CampaignScheduleEnum"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "message_schedules": {
                "description": "List of per-message scheduling configurations",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/InlineMessageSchedule"
                }
              }
            },
            "required": [
              "message_schedules"
            ]
          },
          "relationships": {
            "type": "object",
            "properties": {
              "campaign": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/CampaignEnum"
                      },
                      "id": {
                        "description": "The campaign to schedule",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            },
            "required": [
              "campaign"
            ]
          }
        },
        "required": [
          "type",
          "attributes",
          "relationships"
        ]
      },
      "InlineMessageSchedule": {
        "type": "object",
        "properties": {
          "send_time": {
            "description": "The datetime at which the message should be sent (must be in the future). Required when strategy is not 'smart_send_time'.",
            "type": "string",
            "format": "date-time",
            "example": "2026-08-01T14:30:00+00:00",
            "nullable": true
          },
          "send_date": {
            "description": "The date on which the message should be sent. Required when strategy is 'smart_send_time'. Must not be in the past.",
            "type": "string",
            "format": "date",
            "example": "2026-08-01",
            "nullable": true
          },
          "strategy": {
            "description": "The send strategy to use: static, local_timezone, throttled, or smart_send_time",
            "type": "string",
            "example": "static",
            "enum": [
              "local_timezone",
              "smart_send_time",
              "static",
              "throttled"
            ]
          },
          "throttled_options": {
            "description": "Required when strategy is 'throttled'. Configuration for throttled sending.",
            "$ref": "#/components/schemas/ThrottledOptions",
            "nullable": true
          },
          "timezone_options": {
            "description": "Optional when strategy is 'local_timezone'. Configuration for timezone-based sending.",
            "$ref": "#/components/schemas/TimezoneOptions",
            "nullable": true
          },
          "message_id": {
            "description": "The campaign message ID to schedule",
            "type": "string",
            "example": "925e385b52fb405715f3616c337cc65c"
          }
        },
        "required": [
          "strategy",
          "message_id"
        ]
      },
      "InlineMessageScheduleResult": {
        "type": "object",
        "properties": {
          "send_time": {
            "description": "The datetime at which the message is scheduled to send. Null for smart_send_time strategy.",
            "type": "string",
            "format": "date-time",
            "example": "2022-11-08T00:00:00+00:00",
            "nullable": true
          },
          "send_date": {
            "description": "The date on which the message is scheduled to send (present for smart_send_time strategy)",
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "strategy": {
            "description": "The send strategy used for scheduling",
            "type": "string",
            "enum": [
              "local_timezone",
              "smart_send_time",
              "static",
              "throttled"
            ]
          },
          "throttling_percentage": {
            "description": "Percentage of recipients sent to per throttle unit. Present when strategy is 'throttled'.",
            "type": "integer",
            "nullable": true
          },
          "throttle_unit": {
            "description": "The time unit each batch of recipients is sent over. Present when strategy is 'throttled'.",
            "type": "string",
            "enum": [
              "hour",
              "minute"
            ],
            "nullable": true
          },
          "id": {
            "description": "The ID of the scheduled campaign message",
            "type": "string",
            "example": "925e385b52fb405715f3616c337cc65c"
          }
        },
        "required": [
          "strategy",
          "id"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "PostCampaignScheduleResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/components/schemas/CampaignScheduleEnum"
              },
              "id": {
                "description": "The ID of the campaign scheduling job",
                "type": "string",
                "example": "925e385b52fb405715f3616c337cc65c"
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "messages": {
                    "description": "Scheduling results for each campaign message",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/InlineMessageScheduleResult"
                    }
                  }
                },
                "required": [
                  "messages"
                ]
              },
              "relationships": {
                "type": "object",
                "properties": {
                  "campaign": {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "$ref": "#/components/schemas/CampaignEnum"
                          },
                          "id": {
                            "description": "Related Campaign",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "id"
                        ]
                      },
                      "links": {
                        "$ref": "#/components/schemas/RelationshipLinks"
                      }
                    }
                  }
                }
              },
              "links": {
                "$ref": "#/components/schemas/ObjectLinks"
              }
            },
            "required": [
              "type",
              "id",
              "attributes",
              "links"
            ]
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data"
        ]
      },
      "RelationshipLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          },
          "related": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self",
          "related"
        ]
      },
      "ResponseMeta": {
        "description": "Response-level metadata",
        "type": "object",
        "properties": {
          "agent_hints": {
            "$ref": "#/components/schemas/AgentHints"
          }
        }
      },
      "ThrottledOptions": {
        "type": "object",
        "properties": {
          "throttling_percentage": {
            "description": "Percentage of recipients to send to per throttle unit (1, 2, 5, 10, 11, 13, 14, 17, 20, 25, 33, or 50)",
            "type": "integer",
            "example": 20
          },
          "throttle_unit": {
            "description": "The time unit each batch of recipients is sent over: 'hour' or 'minute'.",
            "type": "string",
            "example": "hour",
            "default": "hour",
            "enum": [
              "hour",
              "minute"
            ]
          }
        },
        "required": [
          "throttling_percentage"
        ]
      },
      "TimezoneOptions": {
        "type": "object",
        "properties": {
          "send_past_timezones_tomorrow": {
            "description": "If true, recipients in timezones where the send time has already passed will receive the message the following day. If false, they receive it immediately.",
            "type": "boolean",
            "default": false,
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Campaigns",
      "description": "campaigns"
    }
  ]
}
