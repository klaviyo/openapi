      "TemplateConversionJobEnum": {
        "type": "string",
        "enum": [
          "template-conversion-job"
        ]
      },
      "TemplateConversionJobResponseObjectResource": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TemplateConversionJobEnum"
          },
          "id": {
            "description": "ID of the conversion job.",
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "status": {
                "description": "The status of the job.",
                "type": "string",
                "enum": [
                  "complete",
                  "failed",
                  "processing",
                  "queued"
                ]
              },
              "created_at": {
                "description": "Datetime when the job was created.",
                "type": "string",
                "format": "date-time",
                "example": "2022-11-08T00:00:00+00:00"
              },
              "error": {
                "description": "Why the conversion failed. Null unless the status is failed.",
                "type": "string",
                "nullable": true
              },
              "completed_at": {
                "description": "Datetime when the job completed or failed.",
                "type": "string",
                "format": "date-time",
                "example": "2022-11-08T00:00:00+00:00",
                "nullable": true
              }
            },
            "required": [
              "status",
              "created_at"
            ]
          },
          "relationships": {
            "type": "object",
            "properties": {
              "source-template": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/TemplateEnum"
                      },
                      "id": {
                        "description": "The HTML template being converted.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  },
                  "links": {
                    "$ref": "#/components/schemas/RelationshipLinks"
                  }
                }
              },
              "converted-template": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/TemplateEnum"
                      },
                      "id": {
                        "description": "The drag-and-drop template created by the conversion. Absent until the status is complete.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  },
                  "links": {
                    "$ref": "#/components/schemas/RelationshipLinks"
                  }
                }
              }
            }
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "TemplateEnum": {
        "type": "string",
        "enum": [
          "template"
        ]
      }
