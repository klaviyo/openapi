    "schemas": {
      "KsqlAskRequestRequest": {
        "type": "object",
        "properties": {
          "question": {
            "description": "The natural-language question to ask. 1-2000 characters.",
            "type": "string",
            "example": "How many orders were placed last week?"
          },
          "max_rows": {
            "description": "Cap on rows per result set. 1-1000.",
            "type": "integer",
            "example": 100,
            "default": 100
          }
        },
        "required": [
          "question"
        ]
      },
      "KsqlAskRequestRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/KsqlAskResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/KsqlAskRequestRequest"
          }
        },
        "required": [
          "type",
          "attributes"
        ]
      },
      "KsqlAskRequestRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/KsqlAskRequestRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "KsqlAskResourceName": {
        "type": "string",
        "enum": [
          "ksql-ask"
        ]
      },
      "KsqlAskResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Whether this ask was answered or needs more input.",
            "type": "string",
            "enum": [
              "success",
              "clarification"
            ]
          },
          "answer": {
            "description": "Plain-language answer when `status` is `success`, or the clarifying question back to the caller when `status` is `clarification`.",
            "type": "string"
          },
          "result_sets": {
            "description": "The executed queries' typed result sets supporting `answer`. Always empty when `status` is `clarification`; may also be empty on `success` when the answer required no query execution.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KsqlResultSet"
            },
            "default": []
          },
          "warnings": {
            "description": "Caveats that change how `answer` and `result_sets` should be read -- a sampled result set, row data elided by a cap, a table withheld from this ask. Several conditions are reported nowhere else, so surface these alongside the answer rather than discarding them.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Showing the first 100 of 4,182 matching orders."
            ],
            "default": []
          }
        },
        "required": [
          "status",
          "answer"
        ]
      },
      "KsqlAskResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/KsqlAskResourceName"
          },
          "id": {
            "description": "Identifier for this ask, for joining logs across services.",
            "type": "string"
          },
          "attributes": {
            "$ref": "#/components/schemas/KsqlAskResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "KsqlAskResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/KsqlAskResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "KsqlColumnSchema": {
        "type": "object",
        "properties": {
          "name": {
            "description": "The column's name.",
            "type": "string",
            "example": "order_count"
          },
          "type": {
            "description": "The column's data type. It determines how the column's values appear in `rows`.",
            "type": "string",
            "example": "long",
            "enum": [
              "boolean",
              "long",
              "double",
              "string",
              "timestamptz",
              "unknown"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "KsqlResultSet": {
        "type": "object",
        "properties": {
          "columns": {
            "description": "The result set's columns, in the order their values appear in each row.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KsqlColumnSchema"
            }
          },
          "rows": {
            "description": "The result rows. Each row is a list of values in the same order as `columns`. A value is a boolean for `boolean` columns, a number for `long` and `double` columns, and a string for every other type. A missing value is `null`.",
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "nullable": true
              }
            },
            "example": [
              [
                42,
                19.99
              ]
            ]
          },
          "row_count": {
            "description": "The number of rows in the query's result.",
            "type": "integer",
            "example": 42
          },
          "rows_returned": {
            "description": "The number of rows included in `rows`. This is lower than `row_count` when row data was left out by a cap.",
            "type": "integer",
            "example": 42
          },
          "completeness": {
            "description": "Whether the QUERY's result was complete -- it says nothing about this payload. `sample` means the query's row count equalled its own `LIMIT`, so the underlying result may be larger; `truncated` means it hit K-SQL's own result cap. Compare `rows_returned` to `row_count` for payload elision, which is separate: `complete` with `rows_returned` below `row_count` is a full query result only partially included here.",
            "type": "string",
            "example": "complete",
            "enum": [
              "complete",
              "sample",
              "truncated"
            ]
          },
          "description": {
            "description": "A short plain-language description of what this result set contains.",
            "type": "string",
            "example": "Order count and average price for last week.",
            "nullable": true
          },
          "sql": {
            "description": "The K-SQL query that produced this result set, so you can see how the numbers were derived. Read-only and for explanation only: it is not a stable interface while K-SQL is in alpha -- do not parse it or store it. To run a K-SQL query yourself, see `POST /api/ksql-query`.",
            "type": "string",
            "example": "SELECT count(*) FROM orders WHERE placed_at >= '2026-09-01'",
            "nullable": true
          },
          "caveats": {
            "description": "Caveats about this result set, in plain language and safe to show an end user as sent. The same sentences also appear in the response-level `warnings`; read them here when you need to know which result set a caveat applies to.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Showing the first 100 of 4,182 matching orders."
            ],
            "default": []
          }
        },
        "required": [
          "columns",
          "rows",
          "row_count",
          "rows_returned",
          "completeness"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "SocialReportTimeframeRequest": {
        "type": "object",
        "properties": {
          "key": {
            "description": "Named preset window.",
            "type": "string",
            "example": "last_90_days",
            "enum": [
              "last_7_days",
              "last_30_days",
              "last_90_days",
              "month_to_date"
            ],
            "nullable": true
          },
          "start": {
            "description": "ISO-8601 lower-bound (inclusive) for the report window.",
            "type": "string",
            "format": "date-time",
            "example": "2026-08-07T00:00:00+00:00",
            "nullable": true
          },
          "end": {
            "description": "ISO-8601 upper-bound (exclusive) for the report window.",
            "type": "string",
            "format": "date-time",
            "example": "2026-08-14T00:00:00+00:00",
            "nullable": true
          }
        }
      },
      "SocialSeriesData": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Bucket start date (ISO-8601), unique within the response.",
            "type": "string",
            "example": "2026-08-07T00:00:00+00:00"
          },
          "interval": {
            "description": "Echo of the requested granularity.",
            "type": "string",
            "enum": [
              "day",
              "week"
            ]
          },
          "statistics": {
            "description": "Map of statistic key -> value for this bucket.",
            "type": "object",
            "example": {
              "social_subscribers": 1
            }
          }
        },
        "required": [
          "id",
          "interval",
          "statistics"
        ]
      },
      "SocialSeriesFilterRequest": {
        "type": "object",
        "properties": {
          "channel": {
            "description": "Subscriber-growth channel to scope social_subscribers to. Required when requesting social_subscribers; ignored otherwise.",
            "type": "string",
            "example": "email",
            "enum": [
              "email",
              "sms",
              "whatsapp"
            ],
            "nullable": true
          },
          "automation_id": {
            "description": "Scopes funnel_started/funnel_submitted_identifier/funnel_ended to one auto-reply automation. Required for those statistics.",
            "type": "string",
            "example": "01KTKY9QMP6R13ZMEX1HMAMB8Q",
            "nullable": true
          }
        }
      },
      "SocialSeriesReportQueryRequest": {
        "type": "object",
        "properties": {
          "statistics": {
            "description": "Statistics to compute per time bucket.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialSeriesStatistic"
            },
            "example": [
              "social_subscribers"
            ]
          },
          "timeframe": {
            "description": "Time window for the report.",
            "example": {
              "key": "last_90_days"
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/SocialReportTimeframeRequest"
              }
            ]
          },
          "interval": {
            "description": "Bucket granularity: day or week.",
            "type": "string",
            "example": "day",
            "enum": [
              "day",
              "week"
            ]
          },
          "filter": {
            "description": "Statistic-appropriate filters.",
            "allOf": [
              {
                "$ref": "#/components/schemas/SocialSeriesFilterRequest"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "statistics",
          "timeframe",
          "interval"
        ]
      },
      "SocialSeriesReportQueryRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SocialSeriesReportResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/SocialSeriesReportQueryRequest"
          }
        },
        "required": [
          "type",
          "attributes"
        ]
      },
      "SocialSeriesReportQueryRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SocialSeriesReportQueryRequestData"
          }
        },
        "required": [
          "data"
        ]
