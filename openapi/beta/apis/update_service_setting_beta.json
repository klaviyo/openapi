          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "ServiceSettingUpdateRequestRequest": {
        "type": "object",
        "properties": {
          "office_hours": {
            "description": "When the Helpdesk is open. Fields you omit are left unchanged.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceOfficeHoursUpdateRequest"
              }
            ],
            "nullable": true
