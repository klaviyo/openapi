        ]
      },
      "ServiceOfficeHours": {
        "type": "object",
        "properties": {
          "timezone": {
            "description": "IANA timezone name.",
            "type": "string",
            "example": "America/New_York"
          },
          "weekly_hours": {
            "description": "Open intervals for each day. If every day is empty, the account is always open.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceWeeklyHours"
              }
            ]
          }
        },
        "required": [
          "timezone",
          "weekly_hours"
        ]
      },
      "ServiceOfficeHoursInterval": {
        "type": "object",
        "properties": {
          "start": {
            "description": "Opening time, as `HH:MM`.",
            "type": "string",
            "example": "09:00"
          },
          "end": {
            "description": "Closing time, as `HH:MM`. Must be after `start`.",
            "type": "string",
            "example": "17:00"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "ServiceOfficeHoursIntervalRequest": {
        "type": "object",
        "properties": {
          "start": {
            "description": "Opening time, as `HH:MM`.",
            "type": "string",
            "example": "09:00"
          },
          "end": {
            "description": "Closing time, as `HH:MM`. Must be after `start`.",
            "type": "string",
            "example": "17:00"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "ServiceOfficeHoursUpdateRequest": {
        "type": "object",
        "properties": {
          "timezone": {
            "description": "IANA timezone name. Omit to keep the current timezone.",
            "type": "string",
            "example": "America/New_York",
            "nullable": true
          },
          "weekly_hours": {
            "description": "Replaces the whole week. A day you leave out is closed. Omit to keep the current hours.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceWeeklyHoursRequest"
              }
            ],
            "nullable": true
          }
        }
      },
      "ServiceSettingResourceName": {
        "type": "string",
        "enum": [
          "service-setting"
        ]
      },
      "ServiceSettingResponse": {
        "type": "object",
        "properties": {
          "office_hours": {
            "description": "When the Helpdesk is open.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceOfficeHours"
              }
            ]
          }
        },
        "required": [
          "office_hours"
        ]
      },
      "ServiceSettingResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ServiceSettingResourceName"
          },
          "id": {
            "description": "The account's ID.",
            "type": "string",
            "example": "AbC123"
          },
          "attributes": {
            "$ref": "#/components/schemas/ServiceSettingResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
