    "schemas": {
      "LocationReportTimeframeRequest": {
        "type": "object",
        "properties": {
          "key": {
            "description": "Named preset window.",
            "type": "string",
            "example": "last_30_days",
            "enum": [
              "all_time",
              "today",
              "yesterday",
              "this_week",
              "last_7_days",
              "last_week",
              "this_month",
              "last_30_days",
              "last_month",
              "last_90_days",
              "last_3_months",
              "last_365_days",
              "last_12_months",
              "this_year",
              "last_year"
            ],
            "nullable": true
          },
          "start": {
            "description": "First day to include, in the account's timezone.",
            "type": "string",
            "format": "date-time",
            "example": "2026-09-01T00:00:00+00:00",
            "nullable": true
          },
          "end": {
            "description": "Last day to include, in the account's timezone.",
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T00:00:00+00:00",
            "nullable": true
          }
        }
      },
      "LocationValuesData": {
        "type": "object",
        "properties": {
          "groupings": {
            "description": "The live event, and the host location if you filtered by one.",
            "type": "object",
            "example": {
              "live_event_id": "01JABCDEFGHJKMNPQRSTVWXYZ1"
            }
          },
          "statistics": {
            "description": "Each requested statistic and its value. Null if it isn't available.",
            "type": "object",
            "example": {
              "email_reach": 4200,
              "gross_revenue": 950.5
            }
          }
        },
        "required": [
          "groupings",
          "statistics"
        ]
      },
      "LocationValuesFilterRequest": {
        "type": "object",
        "properties": {
          "live_event_id": {
            "description": "The live event to report on. Required.",
            "type": "string",
            "example": "01JABCDEFGHJKMNPQRSTVWXYZ1",
            "nullable": true
          },
          "location_id": {
            "description": "Only count sales at this host location. Can't be used with reach statistics.",
            "type": "string",
            "example": "01JABCDEFGHJKMNPQRSTVWXYZ0",
            "nullable": true
          }
        }
      },
      "LocationValuesReportQueryRequest": {
        "type": "object",
        "properties": {
          "statistics": {
            "description": "Statistics to return. `email_reach`, `sms_reach`, and `push_reach` count the people your campaigns for this event reached on each channel. `whatsapp_messages_delivered` counts messages, not people. Someone reached on two channels is counted on both, so don't add the channels together. `gross_revenue`, `purchasers`, and `order_count` are in-store sales during the event.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationValuesStatistic"
            },
            "example": [
              "email_reach",
              "gross_revenue"
            ]
          },
          "timeframe": {
            "description": "Must be `{\"key\": \"all_time\"}`. Reach always counts every campaign sent for the event, and sales always cover the event's start and end time.",
            "example": {
              "key": "all_time"
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/LocationReportTimeframeRequest"
              }
            ]
          },
          "filter": {
            "description": "Which live event to report on.",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocationValuesFilterRequest"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "statistics",
          "timeframe"
        ]
      },
      "LocationValuesReportQueryRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/LocationValuesReportResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/LocationValuesReportQueryRequest"
          }
        },
        "required": [
          "type",
          "attributes"
        ]
      },
      "LocationValuesReportQueryRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LocationValuesReportQueryRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "LocationValuesReportResourceName": {
        "type": "string",
        "enum": [
          "location-values-report"
        ]
      },
      "LocationValuesReportResponse": {
        "type": "object",
        "properties": {
          "results": {
            "description": "One row per live event.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationValuesData"
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "LocationValuesReportResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/LocationValuesReportResourceName"
          },
          "id": {
            "description": "Opaque identifier for this report response.",
            "type": "string",
            "example": "b13f8dea-895a-4a7c-a349-cc8efd25b1ba"
          },
          "attributes": {
            "$ref": "#/components/schemas/LocationValuesReportResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "LocationValuesReportResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LocationValuesReportResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "LocationValuesStatistic": {
        "description": "Totals for a live event.",
        "type": "string",
        "enum": [
          "email_reach",
          "sms_reach",
          "push_reach",
          "whatsapp_messages_delivered",
          "gross_revenue",
          "purchasers",
          "order_count"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
