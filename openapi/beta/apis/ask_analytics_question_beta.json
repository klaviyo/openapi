    }
  ],
  "security": [
    {
      "Klaviyo-API-Key": []
    }
  ],
  "paths": {
    "/api/ksql-ask": {
      "post": {
        "operationId": "ask_analytics_question_beta",
        "summary": "Ask Analytics Question",
        "description": "\n            > \ud83d\udea7 This endpoint is in beta and subject to change.\n            >\n            > A beta revision header (2026-10-15.pre) is required to use our beta APIs. Klaviyo APIs in beta are not intended for use in production. See our [versioning and deprecation policy](https://developers.klaviyo.com/en/docs/api_versioning_and_deprecation_policy) for more information.\n\nAsk a question about your account data in plain language and get a plain-language answer.\n\nK-SQL turns your question into read-only queries over your account's data, runs them, and summarizes the results. The result sets behind the answer are included so you can see how it was reached.\n\nIf the question is too ambiguous to answer, `status` is `clarification` and `answer` contains a question for you. Ask again with more detail.\n\nAn answer can only draw on data that your API key or OAuth token has scopes for. Each request uses Composer AI Credits. This API is available to accounts that have been enabled for it.\n\nAnswers can take several seconds, so allow for this in your client's request timeout.<br><br>*Rate limits*:<br>Burst: `1/s`<br>Steady: `15/m`\n\n**Optional Scopes:**\n`campaigns:read`\n`catalogs:read`\n`events:read`\n`lists:read`\n`metrics:read`\n`profiles:read`\n`segments:read`\n\n[OpenAPI Spec](https://raw.githubusercontent.com/klaviyo/openapi/main/openapi/beta/apis/ask_analytics_question_beta.json)",
        "parameters": [
          {
            "name": "fields[ksql-ask]",
            "in": "query",
            "description": "For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#sparse-fieldsets",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "answer",
                  "id",
                  "result_sets",
                  "status",
                  "warnings"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "revision",
            "in": "header",
            "description": "API endpoint revision (format: YYYY-MM-DD[.suffix])",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2026-10-15.pre"
            }
          }
        ],
        "requestBody": {
          "description": "A natural-language question about your account data.",
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "$ref": "#/components/schemas/KsqlAskRequestRequestDataWrapper"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/KsqlAskResponseDataWrapper"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "tags": [
          "Beta APIs"
        ],
        "x-klaviyo-operation-aliases": [
          "create_ksql_ask"
        ],
        "x-klaviyo-optional-scopes": [
          "campaigns:read",
          "catalogs:read",
          "events:read",
          "lists:read",
          "metrics:read",
          "profiles:read",
          "segments:read"
        ],
        "x-klaviyo-pre-release": "BETA",
        "x-klaviyo-ratelimit": {
          "burst": "1/s",
          "steady": "15/m"
        },
        "x-klaviyo-scopes": [
          "campaigns:read",
          "catalogs:read",
          "events:read",
          "lists:read",
          "metrics:read",
          "profiles:read",
          "segments:read"
        ],
        "x-klaviyo-subtag": "Reporting"
      }
    }
  },
  "components": {
    "responses": {
      "ClientError": {
        "description": "Client Error",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "code",
                      "title",
                      "detail"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "pointer": {
                            "type": "string"
                          },
                          "parameter": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      },
      "ServerError": {
        "description": "Server Error",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "code",
                      "title",
                      "detail"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "pointer": {
                            "type": "string"
                          },
                          "parameter": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "KsqlAskRequestRequest": {
        "type": "object",
        "properties": {
          "question": {
            "description": "The natural-language question to ask. 1-2000 characters.",
            "type": "string",
            "example": "How many orders were placed last week?"
          },
          "max_rows": {
            "description": "Cap on rows per result set. 1-1000.",
            "type": "integer",
            "example": 100,
            "default": 100
          }
        },
        "required": [
          "question"
        ]
      },
      "KsqlAskRequestRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/KsqlAskResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/KsqlAskRequestRequest"
          }
        },
        "required": [
          "type",
          "attributes"
        ]
      },
      "KsqlAskRequestRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/KsqlAskRequestRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "KsqlAskResourceName": {
        "type": "string",
        "enum": [
          "ksql-ask"
        ]
      },
      "KsqlAskResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Whether this ask was answered or needs more input.",
            "type": "string",
            "enum": [
              "success",
              "clarification"
            ]
          },
          "answer": {
            "description": "Plain-language answer when `status` is `success`, or the clarifying question back to the caller when `status` is `clarification`.",
            "type": "string"
          },
          "result_sets": {
            "description": "The executed queries' typed result sets supporting `answer`. Always empty when `status` is `clarification`; may also be empty on `success` when the answer required no query execution.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KsqlResultSet"
            },
            "default": []
          },
          "warnings": {
            "description": "Caveats that change how `answer` and `result_sets` should be read -- a sampled result set, row data elided by a cap, a table withheld from this ask. Several conditions are reported nowhere else, so surface these alongside the answer rather than discarding them.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Showing the first 100 of 4,182 matching orders."
            ],
            "default": []
          }
        },
        "required": [
          "status",
          "answer"
        ]
      },
      "KsqlAskResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/KsqlAskResourceName"
          },
          "id": {
            "description": "Identifier for this ask, for joining logs across services.",
            "type": "string"
          },
          "attributes": {
            "$ref": "#/components/schemas/KsqlAskResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "KsqlAskResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/KsqlAskResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "KsqlColumnSchema": {
        "type": "object",
        "properties": {
          "name": {
            "description": "The column's name.",
            "type": "string",
            "example": "order_count"
          },
          "type": {
            "description": "The column's data type. It determines how the column's values appear in `rows`.",
            "type": "string",
            "example": "long",
            "enum": [
              "boolean",
              "long",
              "double",
              "string",
              "timestamptz",
              "unknown"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "KsqlResultSet": {
        "type": "object",
        "properties": {
          "columns": {
            "description": "The result set's columns, in the order their values appear in each row.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KsqlColumnSchema"
            }
          },
          "rows": {
            "description": "The result rows. Each row is a list of values in the same order as `columns`. A value is a boolean for `boolean` columns, a number for `long` and `double` columns, and a string for every other type. A missing value is `null`.",
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "nullable": true
              }
            },
            "example": [
              [
                42,
                19.99
              ]
            ]
          },
          "row_count": {
            "description": "The number of rows in the query's result.",
            "type": "integer",
            "example": 42
          },
          "rows_returned": {
            "description": "The number of rows included in `rows`. This is lower than `row_count` when row data was left out by a cap.",
            "type": "integer",
            "example": 42
          },
          "completeness": {
            "description": "Whether the QUERY's result was complete -- it says nothing about this payload. `sample` means the query's row count equalled its own `LIMIT`, so the underlying result may be larger; `truncated` means it hit K-SQL's own result cap. Compare `rows_returned` to `row_count` for payload elision, which is separate: `complete` with `rows_returned` below `row_count` is a full query result only partially included here.",
            "type": "string",
            "example": "complete",
            "enum": [
              "complete",
              "sample",
              "truncated"
            ]
          },
          "description": {
            "description": "A short plain-language description of what this result set contains.",
            "type": "string",
            "example": "Order count and average price for last week.",
            "nullable": true
          },
          "sql": {
            "description": "The K-SQL query that produced this result set, so you can see how the numbers were derived. Read-only and for explanation only: it is not a stable interface while K-SQL is in alpha -- do not parse it or store it. To run a K-SQL query yourself, see `POST /api/ksql-query`.",
            "type": "string",
            "example": "SELECT count(*) FROM orders WHERE placed_at >= '2026-09-01'",
            "nullable": true
          },
          "caveats": {
            "description": "Caveats about this result set, in plain language and safe to show an end user as sent. The same sentences also appear in the response-level `warnings`; read them here when you need to know which result set a caveat applies to.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Showing the first 100 of 4,182 matching orders."
            ],
            "default": []
          }
        },
        "required": [
          "columns",
          "rows",
          "row_count",
          "rows_returned",
          "completeness"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Beta APIs",
      "description": "beta apis"
    }
  ]
}
