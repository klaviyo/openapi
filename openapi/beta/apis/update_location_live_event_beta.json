    "schemas": {
      "IncludedSegmentResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SegmentResourceName"
          },
          "id": {
            "description": "Identifier of the segment.",
            "type": "string",
            "example": "01HQ8V5X9K2M4N6P8R0T2W4Y6A"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "links"
        ]
      },
      "LiveEventResponse": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Name of the event.",
            "type": "string",
            "example": "Summer Pop-Up"
          },
          "event_type": {
            "description": "Your own category for this event.",
            "type": "string",
            "example": "pop-up",
            "nullable": true
          },
          "description": {
            "description": "Free-text description of the event.",
            "type": "string",
            "nullable": true
          },
          "url": {
            "description": "Web page for this event.",
            "type": "string",
            "nullable": true
          },
          "starts_at": {
            "description": "Date and time the event starts.",
            "type": "string",
            "format": "date-time",
            "example": "2026-07-01T18:00:00Z"
          },
          "ends_at": {
            "description": "Date and time the event ends.",
            "type": "string",
            "format": "date-time",
            "example": "2026-07-01T22:00:00Z",
            "nullable": true
          },
          "timezone": {
            "description": "IANA time zone `starts_at` and `ends_at` are interpreted in for display, resolved from the event's address.",
            "type": "string",
            "example": "America/New_York",
            "nullable": true
          },
          "address1": {
            "description": "First line of the street address.",
            "type": "string",
            "example": "125 Summer St",
            "nullable": true
          },
          "address2": {
            "description": "Second line of the street address, such as a suite or floor.",
            "type": "string",
            "nullable": true
          },
          "city": {
            "description": "City or town.",
            "type": "string",
            "example": "Boston",
            "nullable": true
          },
          "region": {
            "description": "State, province, or other top-level administrative area.",
            "type": "string",
            "example": "MA",
            "nullable": true
          },
          "zip": {
            "description": "Postal code.",
            "type": "string",
            "example": "02110",
            "nullable": true
          },
          "country": {
            "description": "Country name or ISO country code.",
            "type": "string",
            "example": "US",
            "nullable": true
          },
          "latitude": {
            "description": "Latitude of the event, resolved by geocoding when not supplied directly.",
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "description": "Longitude of the event, resolved by geocoding when not supplied directly.",
            "type": "number",
            "nullable": true
          },
          "geocode_status": {
            "description": "Whether the supplied address has been resolved to coordinates. Events still `pending` or `queued` have no latitude or longitude yet.",
            "type": "string",
            "example": "queued",
            "enum": [
              "pending",
              "queued",
              "successful",
              "failed"
            ],
            "nullable": true
          },
          "profile_property_value": {
            "description": "Value written to the location profile property on profiles associated with this event.",
            "type": "string",
            "nullable": true
          },
          "profile_count": {
            "description": "Number of profiles currently associated with this event. Recomputed periodically, so it lags recent segment membership changes.",
            "type": "integer",
            "nullable": true
          },
          "segment_count": {
            "description": "Number of segments linked to this event. Available via `?include=segments`.",
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "name",
          "starts_at"
        ]
      },
      "LiveEventResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/LocationLiveEventResourceName"
          },
          "id": {
            "description": "Primary key that uniquely identifies this live event.",
            "type": "string",
            "example": "01HQ8V5X9K2M4N6P8R0T2W4Y6B"
          },
          "attributes": {
            "$ref": "#/components/schemas/LiveEventResponse"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "host-locations": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "$ref": "#/components/schemas/LocationResourceName"
                        },
                        "id": {
                          "description": "IDs of the physical locations hosting this event.",
                          "type": "string",
                          "example": [
                            "01HQ8V5X9K2M4N6P8R0T2W4Y6A"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ]
                    }
                  }
                }
              },
              "segments": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "$ref": "#/components/schemas/SegmentResourceName"
                        },
                        "id": {
                          "description": "IDs of the segments linked to this event. Available via `?include=segments`.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ]
                    }
                  }
                }
              }
            }
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "LiveEventResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LiveEventResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          },
          "included": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncludedSegmentResponseData"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "LiveEventUpdateRequestRequest": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Name of the event. Leading and trailing whitespace is stripped; the result must be non-empty. Maximum 255 characters.",
            "type": "string",
            "example": "Summer Pop-Up",
            "nullable": true
          },
          "starts_at": {
            "description": "New start date and time.",
            "type": "string",
            "format": "date-time",
            "example": "2026-07-01T18:00:00Z",
            "nullable": true
          },
          "ends_at": {
            "description": "New end date and time. Must not be earlier than `starts_at` when both are sent in the same request.",
            "type": "string",
            "format": "date-time",
            "example": "2026-07-01T23:00:00Z",
            "nullable": true
          },
          "event_type": {
            "description": "Your own category for this event. Maximum 50 characters.",
            "type": "string",
            "example": "pop-up",
            "nullable": true
          },
          "address1": {
            "description": "First line of the street address.",
            "type": "string",
            "example": "125 Summer St",
            "nullable": true
          },
          "address2": {
            "description": "Second line of the street address, such as a suite or floor.",
            "type": "string",
            "nullable": true
          },
          "city": {
            "description": "City or town.",
            "type": "string",
            "example": "Boston",
            "nullable": true
          },
          "region": {
            "description": "State, province, or other top-level administrative area.",
            "type": "string",
            "example": "MA",
            "nullable": true
          },
          "zip": {
            "description": "Postal code.",
            "type": "string",
            "example": "02110",
            "nullable": true
          },
          "country": {
            "description": "Country name or ISO country code.",
            "type": "string",
            "example": "US",
            "nullable": true
          },
          "latitude": {
            "description": "Latitude of the event.",
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "description": "Longitude of the event.",
            "type": "number",
            "nullable": true
          },
          "description": {
            "description": "Free-text description of the event.",
            "type": "string",
            "nullable": true
          },
          "url": {
            "description": "Web page for this event. Maximum 500 characters.",
            "type": "string",
            "nullable": true
          },
          "profile_property_value": {
            "description": "Value written to the location profile property on profiles associated with this event. Maximum 500 characters.",
            "type": "string",
            "nullable": true
          }
        }
      },
      "LiveEventUpdateRequestRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/LocationLiveEventResourceName"
          },
          "id": {
            "description": "Identifier of the live event to update. Must match the id in the path.",
            "type": "string",
            "example": "01HQ8V5X9K2M4N6P8R0T2W4Y6B"
          },
          "attributes": {
            "$ref": "#/components/schemas/LiveEventUpdateRequestRequest"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "host-locations": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "$ref": "#/components/schemas/LocationResourceName"
                        },
                        "id": {
                          "description": "Full replacement for the physical locations hosting this event. Omit to leave unchanged.",
                          "type": "string",
                          "example": [
                            "01HQ8V5X9K2M4N6P8R0T2W4Y6A"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "type",
          "id",
          "attributes"
        ]
      },
      "LiveEventUpdateRequestRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LiveEventUpdateRequestRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "LocationLiveEventResourceName": {
        "type": "string",
        "enum": [
          "location-live-event"
        ]
      },
      "LocationResourceName": {
        "type": "string",
        "enum": [
          "location"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "SegmentResourceName": {
        "type": "string",
        "enum": [
          "segment"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
