            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "ServiceTicketCSATQuestionType": {
        "description": "What a CSAT question asks for.",
        "type": "string",
        "enum": [
          "rating",
          "text",
          "text_and_rating"
        ]
      },
      "ServiceTicketCSATSurveyQuestion": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ServiceTicketCSATQuestionType"
          },
          "placeholder": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "question",
          "type"
        ]
      },
      "ServiceTicketCSATSurveyResponse": {
        "type": "object",
        "properties": {
          "enabled": {
            "description": "Whether customers are sent the survey.",
            "type": "boolean",
            "example": true
          },
          "style": {
            "description": "How the survey is shown to customers.",
            "type": "string",
            "example": "basic",
            "enum": [
              "basic",
              "rich"
            ]
          },
          "icon": {
            "description": "Rating icons, for a `rich` survey.",
            "type": "string",
            "example": "stars",
            "enum": [
              "emoji",
              "flat",
              "stars"
            ],
            "nullable": true
          },
          "questions": {
            "description": "The survey's questions. A CSAT response answers each by its `question` text.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceTicketCSATSurveyQuestion"
            }
          }
        },
        "required": [
          "enabled",
          "style",
          "questions"
        ]
      },
      "ServiceTicketCSATSurveyResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ServiceTicketCsatSurveyResourceName"
          },
          "id": {
            "description": "The account's ID.",
            "type": "string",
            "example": "AbC123"
          },
          "attributes": {
            "$ref": "#/components/schemas/ServiceTicketCSATSurveyResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "ServiceTicketCSATSurveyResponseDataListWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceTicketCSATSurveyResponseData"
            }
          },
          "links": {
            "$ref": "#/components/schemas/CollectionLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "ServiceTicketCsatSurveyResourceName": {
        "type": "string",
        "enum": [
          "service-ticket-csat-survey"
        ]
      }
    },
