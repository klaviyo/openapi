  "security": [
    {
      "Klaviyo-API-Key": []
    }
  ],
  "paths": {
    "/api/customer-agent-conversations/{id}": {
      "patch": {
        "operationId": "update_customer_agent_conversation_beta",
        "summary": "Update Conversation",
        "description": "\n            > \ud83d\udea7 This endpoint is in beta and subject to change.\n            >\n            > A beta revision header (2026-10-15.pre) is required to use our beta APIs. Klaviyo APIs in beta are not intended for use in production. See our [versioning and deprecation policy](https://developers.klaviyo.com/en/docs/api_versioning_and_deprecation_policy) for more information.\n\nUpdate a Customer Agent conversation.\n\n``status``, ``customer``, and ``profile`` are the only updatable fields, and at least one must be provided. Only ``status: closed`` is accepted. ``customer`` can only be set once. ``profile`` can be added once, including to a conversation that already has ``customer``, to sign the customer in.<br><br>*Rate limits*:<br>Burst: `3/s`<br>Steady: `60/m`\n\n**Scopes:**\n`agents:write`\n\n[OpenAPI Spec](https://raw.githubusercontent.com/klaviyo/openapi/main/openapi/beta/apis/update_customer_agent_conversation_beta.json)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields[customer-agent-conversation]",
            "in": "query",
            "description": "For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#sparse-fieldsets",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "channel",
                  "created_at",
                  "customer",
                  "customer.email",
                  "customer.first_name",
                  "customer.last_name",
                  "customer.phone_number",
                  "id",
                  "mode",
                  "status",
                  "updated_at"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "revision",
            "in": "header",
            "description": "API endpoint revision (format: YYYY-MM-DD[.suffix])",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2026-10-15.pre"
            }
          }
        ],
        "requestBody": {
          "description": "Sparse request to update a Customer Agent conversation.\n\n``status``, ``customer``, and ``profile`` are the only updatable fields, and at least one must be provided. Only ``status: closed`` is accepted today \u2014 the public surface exposes a single allowed transition (open \u2192 closed). Future statuses will require shared billing / event-emission plumbing currently coupled to the upstream-state-driven PUT. ``customer`` can only be set once, and ``profile`` can be added once, including to a conversation that already has ``customer``.",
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationUpdateRequestRequestDataWrapper"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponseDataWrapper"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "tags": [
          "Beta APIs"
        ],
        "x-klaviyo-pre-release": "BETA",
        "x-klaviyo-ratelimit": {
          "burst": "3/s",
          "steady": "60/m"
        },
        "x-klaviyo-scopes": [
          "agents:write"
        ],
        "x-klaviyo-subtag": "Customer Agent"
      }
    }
  },
  "components": {
    "responses": {
      "ClientError": {
        "description": "Client Error",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "code",
                      "title",
                      "detail"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "pointer": {
                            "type": "string"
                          },
                          "parameter": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      },
      "ServerError": {
        "description": "Server Error",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "code",
                      "title",
                      "detail"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "pointer": {
                            "type": "string"
                          },
                          "parameter": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "ClosedEnum": {
        "type": "string",
        "enum": [
          "closed"
        ]
      },
      "ConversationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Current lifecycle status of the conversation.",
            "type": "string",
            "example": "resolved-by-ai",
            "enum": [
              "open",
              "routed-to-team",
              "resolved-by-ai",
              "closed"
            ]
          },
          "mode": {
            "description": "Whether the conversation is for testing or a real shopper interaction.",
            "type": "string",
            "enum": [
              "preview",
              "live"
            ]
          },
          "channel": {
            "description": "Channel this conversation is associated with, if known.",
            "type": "string",
            "enum": [
              "web-chat",
              "sms",
              "email",
              "whatsapp",
              "instagram",
              "voice"
            ],
            "nullable": true
          },
          "customer": {
            "description": "Contact details that identify the customer, if any.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Customer"
              }
            ],
            "nullable": true
          },
          "created_at": {
            "description": "Date and time when the conversation was created.",
            "type": "string",
            "format": "date-time",
            "example": "2026-05-13T12:00:00+00:00"
          },
          "updated_at": {
            "description": "Date and time when the conversation was last updated.",
            "type": "string",
            "format": "date-time",
            "example": "2026-05-13T12:05:00+00:00"
          }
        },
        "required": [
          "status",
          "mode",
          "created_at",
          "updated_at"
        ]
      },
      "ConversationResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CustomerAgentConversationResourceName"
          },
          "id": {
            "description": "Conversation identifier. Treat it as an opaque string; its format varies by where the conversation started.",
            "type": "string",
            "example": "d1cfa5b1-80ce-4069-8067-b708dab722bd"
          },
          "attributes": {
            "$ref": "#/components/schemas/ConversationResponse"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ProfileResourceName"
                      },
                      "id": {
                        "description": "Signed-in Klaviyo profile of the customer, if any.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              },
              "customer-agent-messages": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "$ref": "#/components/schemas/CustomerAgentMessageResourceName"
                        },
                        "id": {
                          "description": "Message turns in this conversation.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ]
                    }
                  },
                  "links": {
                    "$ref": "#/components/schemas/RelationshipLinks"
                  }
                }
              }
            },
            "required": [
              "customer-agent-messages"
            ]
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "relationships",
          "links"
        ]
      },
      "ConversationResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ConversationResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "ConversationUpdateRequestRequest": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClosedEnum"
              }
            ],
            "nullable": true
          },
          "customer": {
            "description": "Contact details that identify the customer. Events from this conversation are recorded on the matching Klaviyo profile, and the agent uses these details to personalize replies. Does not sign the customer in or give access to their orders or account; use `profile` for that. Can only be set once.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerRequest"
              }
            ],
            "nullable": true
          }
        }
      },
      "ConversationUpdateRequestRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CustomerAgentConversationResourceName"
          },
          "id": {
            "type": "string"
          },
          "attributes": {
            "$ref": "#/components/schemas/ConversationUpdateRequestRequest"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ProfileResourceName"
                      },
                      "id": {
                        "description": "Signs the customer in, letting Customer Agent look up their orders, returns, subscriptions, and loyalty details. Only set this for a customer you have verified. Can be added once, including after `customer` is set, to sign in a customer identified earlier in the conversation.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            }
          }
        },
        "required": [
          "type",
          "id",
          "attributes"
        ]
      },
      "ConversationUpdateRequestRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ConversationUpdateRequestRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "phone_number": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CustomerAgentConversationResourceName": {
        "type": "string",
        "enum": [
          "customer-agent-conversation"
        ]
      },
      "CustomerAgentMessageResourceName": {
        "type": "string",
        "enum": [
          "customer-agent-message"
        ]
      },
      "CustomerRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "phone_number": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "ProfileResourceName": {
        "type": "string",
        "enum": [
          "profile"
        ]
      },
      "RelationshipLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          },
          "related": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self",
          "related"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Beta APIs",
      "description": "beta apis"
    }
