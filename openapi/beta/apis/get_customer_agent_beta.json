  "paths": {
    "/api/customer-agents/{id}": {
      "get": {
        "operationId": "get_customer_agent_beta",
        "summary": "Get Customer Agent",
        "description": "\n            > \ud83d\udea7 This endpoint is in beta and subject to change.\n            >\n            > A beta revision header (2026-10-15.pre) is required to use our beta APIs. Klaviyo APIs in beta are not intended for use in production. See our [versioning and deprecation policy](https://developers.klaviyo.com/en/docs/api_versioning_and_deprecation_policy) for more information.\n\nReturns the Customer Agent resource for the calling company.\n\nIncludes ``name``, ``tone_of_voice`` with preset and optional custom instruction, ``escalation_rules``, ``communication_styles``, the account-wide default ``handoff`` configuration, and ``channels``. Each channel reports whether it is ``enabled`` and the ``blockers`` that stop it from being enabled. There is one Customer Agent per company; its ``id`` is the account's ID, which Get Customer Agents returns.<br><br>*Rate limits*:<br>Burst: `10/s`<br>Steady: `150/m`\n\n**Scopes:**\n`agents:read`\n\n[OpenAPI Spec](https://raw.githubusercontent.com/klaviyo/openapi/main/openapi/beta/apis/get_customer_agent_beta.json)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields[customer-agent]",
            "in": "query",
            "description": "For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#sparse-fieldsets",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "channels",
                  "channels.email",
                  "channels.email.blockers",
                  "channels.email.enabled",
                  "channels.sms",
                  "channels.sms.blockers",
                  "channels.sms.enabled",
                  "channels.web_chat",
                  "channels.web_chat.blockers",
                  "channels.web_chat.enabled",
                  "channels.whatsapp",
                  "channels.whatsapp.blockers",
                  "channels.whatsapp.enabled",
                  "communication_styles",
                  "escalation_rules",
                  "handoff",
                  "handoff.email_address",
                  "handoff.fallback_message",
                  "handoff.handoff_message",
                  "handoff.include_ticket_id",
                  "handoff.mechanism",
                  "id",
                  "name",
                  "tone_of_voice",
                  "tone_of_voice.custom_instruction",
                  "tone_of_voice.preset"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "revision",
            "in": "header",
            "description": "API endpoint revision (format: YYYY-MM-DD[.suffix])",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2026-10-15.pre"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAgentResponseDataWrapper"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "tags": [
          "Beta APIs"
        ],
        "x-klaviyo-pre-release": "BETA",
        "x-klaviyo-ratelimit": {
          "burst": "10/s",
          "steady": "150/m"
        },
        "x-klaviyo-scopes": [
          "agents:read"
        ],
        "x-klaviyo-subtag": "Customer Agent"
      }
    }
  },
