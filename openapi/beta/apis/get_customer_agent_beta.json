    "schemas": {
      "CustomerAgentChannel": {
        "type": "object",
        "properties": {
          "enabled": {
            "description": "Whether the agent answers on this channel.",
            "type": "boolean"
          },
          "blockers": {
            "description": "Reasons the channel cannot be enabled. Read-only. Empty when the channel can be enabled. SMS and WhatsApp always report `NOT_CONFIGURABLE_VIA_API`.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerAgentChannelBlocker"
            }
          }
        },
        "required": [
          "enabled",
          "blockers"
        ]
      },
      "CustomerAgentChannelBlocker": {
        "description": "A reason a channel cannot be enabled.",
        "type": "string",
        "enum": [
          "HANDOFF_NOT_CONFIGURED",
          "FALLBACK_MESSAGE_EMPTY",
          "HELPDESK_NOT_CONNECTED",
          "NO_REMAINING_RESOLUTIONS",
          "WEB_CHAT_NOT_ENABLED",
          "NOT_CONFIGURABLE_VIA_API"
        ]
      },
      "CustomerAgentChannels": {
        "type": "object",
        "properties": {
          "web_chat": {
            "description": "Web chat.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentChannel"
              }
            ]
          },
          "email": {
            "description": "Email.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentChannel"
              }
            ]
          },
          "sms": {
            "description": "SMS. Read-only through the API.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentChannel"
              }
            ]
          },
          "whatsapp": {
            "description": "WhatsApp. Read-only through the API.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentChannel"
              }
            ]
          }
        },
        "required": [
          "web_chat",
          "email",
          "sms",
          "whatsapp"
        ]
      },
      "CustomerAgentCommunicationStyle": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Short, human-readable label for the communication style.",
            "type": "string"
          },
          "description": {
            "description": "Natural-language communication style the agent must follow on every turn.",
            "type": "string"
          },
          "status": {
            "description": "Whether this guidance item is active.",
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "countries": {
            "description": "Countries this rule applies to, as ISO 3166-1 alpha-2 codes. Empty or null means every country.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "languages": {
            "description": "Languages this rule applies to, as ISO 639-1 codes, or ISO 639-3 where none exists. Some languages aren't supported. Empty or null means every language.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "required": [
          "title",
          "description",
          "status"
        ]
      },
      "CustomerAgentEscalationRule": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Short, human-readable label for the escalation rule.",
            "type": "string"
          },
          "description": {
            "description": "Natural-language description of when this rule fires.",
            "type": "string"
          },
          "status": {
            "description": "Whether this guidance item is active.",
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "countries": {
            "description": "Countries this rule applies to, as ISO 3166-1 alpha-2 codes. Empty or null means every country.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "languages": {
            "description": "Languages this rule applies to, as ISO 639-1 codes, or ISO 639-3 where none exists. Some languages aren't supported. Empty or null means every language.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "required": [
          "title",
          "description",
          "status"
        ]
      },
      "CustomerAgentHandoff": {
        "type": "object",
        "properties": {
          "mechanism": {
            "description": "How the agent hands a shopper off to a human. Null when the account uses a mechanism this API does not expose.",
            "type": "string",
            "enum": [
              "GORGIAS",
              "ZENDESK",
              "INBOX",
              "OTHER_EMAIL_BASED",
              "FALLBACK_MESSAGE"
            ],
            "nullable": true
          },
          "fallback_message": {
            "description": "Sent when the agent is unable to answer and no human is available.",
            "type": "string",
            "nullable": true
          },
          "handoff_message": {
            "description": "Sent when the agent hands the shopper off to a human.",
            "type": "string",
            "nullable": true
          },
          "include_ticket_id": {
            "description": "Whether the handoff message includes the helpdesk ticket reference number.",
            "type": "boolean"
          },
          "email_address": {
            "description": "Address handoffs are emailed to. Used when `mechanism` is `OTHER_EMAIL_BASED`.",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "include_ticket_id"
        ]
      },
      "CustomerAgentResourceName": {
        "type": "string",
        "enum": [
          "customer-agent"
        ]
      },
      "CustomerAgentResponse": {
        "type": "object",
        "properties": {
          "name": {
            "description": "The name of the AI agent.",
            "type": "string",
            "nullable": true
          },
          "tone_of_voice": {
            "description": "Tone-of-voice settings for the Customer Agent resource.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentToneOfVoice"
              }
            ]
          },
          "escalation_rules": {
            "description": "Natural-language triggers that, when matched, cause the agent to escalate to a human. Each rule is individually enabled or disabled.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerAgentEscalationRule"
            }
          },
          "communication_styles": {
            "description": "Communication styles the agent applies on every turn, such as opening conventions, formatting preferences, and word choices to avoid. Each style is individually enabled or disabled.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerAgentCommunicationStyle"
            }
          },
          "handoff": {
            "description": "The account-wide default handoff configuration, which every channel inherits.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentHandoff"
              }
            ]
          },
          "channels": {
            "description": "Whether each channel is on, and what stops it from being turned on.",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerAgentChannels"
              }
            ]
          }
        },
        "required": [
          "tone_of_voice",
          "escalation_rules",
          "communication_styles",
          "handoff",
          "channels"
        ]
      },
      "CustomerAgentResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CustomerAgentResourceName"
          },
          "id": {
            "description": "Customer Agent resource id. This is the account's ID.",
            "type": "string",
            "example": "AbC123"
          },
          "attributes": {
            "$ref": "#/components/schemas/CustomerAgentResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "CustomerAgentResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CustomerAgentResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "CustomerAgentToneOfVoice": {
        "type": "object",
        "properties": {
          "preset": {
            "description": "Built-in tone preset.",
            "type": "string",
            "enum": [
              "neutral",
              "professional",
              "friendly",
              "playful",
              "custom"
            ]
          },
          "custom_instruction": {
            "description": "Free-text instruction the agent uses for tone when `preset` is `custom`. Ignored otherwise.",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "preset"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Beta APIs",
      "description": "beta apis"
    }
  ]
}
