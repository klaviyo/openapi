          {
            "name": "id",
            "in": "path",
            "description": "The ID of the brand form defaults (must equal the account ID).",
            "required": true,
            "schema": {
              "description": "The ID of the brand form defaults (must equal the account ID).",
              "type": "string",
              "example": "abc123"
            }
          },
          {
            "name": "fields[brand-form-default]",
            "in": "query",
            "description": "For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#sparse-fieldsets",
            "required": false,
            "schema": {
              "type": "array",
