                  "heading_text.text_decoration",
                  "id",
                  "input",
                  "input.background_color",
                  "input.border_color",
                  "input.corner_radius",
                  "input.focus_border_color",
                  "input.input_field_height",
                  "input.input_text",
                  "input.input_text.color",
                  "input.input_text.font_family",
                  "input.input_text.font_size",
                  "input.input_text.font_style",
                  "input.input_text.font_weight",
