                "type": "string",
                "enum": [
                  "background_color",
                  "body_text",
                  "body_text.color",
                  "body_text.font_family",
                  "body_text.font_size",
                  "body_text.font_style",
                  "body_text.font_weight",
                  "body_text.letter_spacing",
                  "body_text.text_decoration",
                  "corner_radius",
                  "heading_text",
                  "heading_text.color",
                  "heading_text.font_family",
