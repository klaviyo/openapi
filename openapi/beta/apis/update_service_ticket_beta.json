      "ServiceTicketResourceName": {
        "type": "string",
        "enum": [
          "service-ticket"
        ]
      },
      "ServiceTicketResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Current status of the ticket.",
            "type": "string",
            "example": "open",
            "enum": [
              "open",
              "closed"
            ]
          },
          "channel": {
            "description": "Channel of the ticket's latest message, if it has any messages.",
            "type": "string",
            "example": "email",
            "nullable": true
          },
          "created_at": {
            "description": "Date and time when the ticket was created.",
            "type": "string",
            "format": "date-time",
            "example": "2026-10-01T12:00:00+00:00"
          },
          "updated_at": {
            "description": "Date and time when the ticket was last updated.",
            "type": "string",
            "format": "date-time",
            "example": "2026-10-02T12:00:00+00:00",
            "nullable": true
          }
        },
        "required": [
          "status",
          "created_at"
        ]
      },
      "ServiceTicketResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ServiceTicketResourceName"
          },
          "id": {
            "description": "Service ticket identifier.",
            "type": "string",
            "example": "01JABCDEFGHJKMNPQRSTVWXYZ0"
          },
          "attributes": {
            "$ref": "#/components/schemas/ServiceTicketResponse"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "service-team": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ServiceTeamResourceName"
                      },
                      "id": {
                        "description": "Team the ticket is assigned to, if any.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              },
              "profile": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ProfileResourceName"
                      },
                      "id": {
                        "description": "Klaviyo profile of the customer, if known.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              },
              "assignee": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/UserResourceName"
                      },
                      "id": {
                        "description": "Klaviyo user the ticket is assigned to, if any.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              },
              "service-ticket-csat-response": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ServiceTicketCsatResponseResourceName"
                      },
                      "id": {
                        "description": "The customer's CSAT response, if they submitted one.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            }
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
