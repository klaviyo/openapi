        "required": [
          "data"
        ]
      },
      "ServiceTicketUpdateRequestRequest": {
        "type": "object",
        "properties": {
          "status": {
            "description": "New status of the ticket. Closing sends the customer the CSAT survey, if CSAT is on.",
            "type": "string",
            "example": "closed",
            "enum": [
              "open",
              "closed"
            ],
            "nullable": true
          }
        }
      },
      "ServiceTicketUpdateRequestRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ServiceTicketResourceName"
          },
          "id": {
            "type": "string"
          },
          "attributes": {
