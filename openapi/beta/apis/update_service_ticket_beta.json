            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "ProfileResourceName": {
        "type": "string",
        "enum": [
          "profile"
        ]
      },
      "ServiceTeamResourceName": {
        "type": "string",
        "enum": [
          "service-team"
        ]
      },
      "ServiceTicketCsatResponseResourceName": {
        "type": "string",
