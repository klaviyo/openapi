    "schemas": {
      "LocationReportTimeframeRequest": {
        "type": "object",
        "properties": {
          "key": {
            "description": "Named preset window.",
            "type": "string",
            "example": "last_30_days",
            "enum": [
              "all_time",
              "today",
              "yesterday",
              "this_week",
              "last_7_days",
              "last_week",
              "this_month",
              "last_30_days",
              "last_month",
              "last_90_days",
              "last_3_months",
              "last_365_days",
              "last_12_months",
              "this_year",
              "last_year"
            ],
            "nullable": true
          },
          "start": {
            "description": "First day to include, in the account's timezone.",
            "type": "string",
            "format": "date-time",
            "example": "2026-09-01T00:00:00+00:00",
            "nullable": true
          },
          "end": {
            "description": "Last day to include, in the account's timezone.",
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T00:00:00+00:00",
            "nullable": true
          }
        }
      },
      "LocationSeriesData": {
        "type": "object",
        "properties": {
          "groupings": {
            "description": "The location this series belongs to.",
            "type": "object",
            "example": {
              "location_id": "01JABCDEFGHJKMNPQRSTVWXYZ0"
            }
          },
          "statistics": {
            "description": "Each requested statistic, with one value per day in `date_times`. Null if the statistic isn't available for this location.",
            "type": "object",
            "example": {
              "revenue": [
                100,
                80
              ],
              "order_count": [
                4,
                2
              ]
            }
          }
        },
        "required": [
          "groupings",
          "statistics"
        ]
      },
      "LocationSeriesFilterRequest": {
        "type": "object",
        "properties": {
          "location_id": {
            "description": "The location to report on. Required.",
            "type": "string",
            "example": "01JABCDEFGHJKMNPQRSTVWXYZ0",
            "nullable": true
          }
        }
      },
      "LocationSeriesReportQueryRequest": {
        "type": "object",
        "properties": {
          "statistics": {
            "description": "Statistics to return for each day. `revenue` is sales after refunds (`gross_revenue` minus `refunds`). `purchasers` counts unique buyers per day, so adding up days can count the same buyer more than once.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationSeriesStatistic"
            },
            "example": [
              "revenue",
              "order_count"
            ]
          },
          "timeframe": {
            "description": "The days to report on. Use a preset `key` or a `start` and `end` up to 365 days apart. `all_time` isn't supported.",
            "example": {
              "key": "last_30_days"
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/LocationReportTimeframeRequest"
              }
            ]
          },
          "interval": {
            "description": "How to group the results. Only `day` is supported.",
            "type": "string",
            "example": "day",
            "enum": [
              "day"
            ]
          },
          "filter": {
            "description": "Which location to report on.",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocationSeriesFilterRequest"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "statistics",
          "timeframe",
          "interval"
        ]
      },
      "LocationSeriesReportQueryRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/LocationSeriesReportResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/LocationSeriesReportQueryRequest"
          }
        },
        "required": [
          "type",
          "attributes"
        ]
      },
      "LocationSeriesReportQueryRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LocationSeriesReportQueryRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "LocationSeriesReportResourceName": {
        "type": "string",
        "enum": [
          "location-series-report"
        ]
      },
      "LocationSeriesReportResponse": {
        "type": "object",
        "properties": {
          "date_times": {
            "description": "The start of each day in the report, in the account's timezone.",
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time",
              "example": "2022-11-08T00:00:00+00:00"
            },
            "example": [
              "2026-10-01T00:00:00+00:00",
              "2026-10-02T00:00:00+00:00"
            ]
          },
          "results": {
            "description": "One series per location.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationSeriesData"
            }
          }
        },
        "required": [
          "date_times",
          "results"
        ]
      },
      "LocationSeriesReportResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/LocationSeriesReportResourceName"
          },
          "id": {
            "description": "Opaque identifier for this report response.",
            "type": "string",
            "example": "b13f8dea-895a-4a7c-a349-cc8efd25b1ba"
          },
          "attributes": {
            "$ref": "#/components/schemas/LocationSeriesReportResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "LocationSeriesReportResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LocationSeriesReportResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "LocationSeriesStatistic": {
        "description": "In-store statistics for a location, one value per interval.",
        "type": "string",
        "enum": [
          "revenue",
          "gross_revenue",
          "refunds",
          "purchasers",
          "order_count"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
