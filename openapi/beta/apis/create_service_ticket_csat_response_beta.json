          "question": {
            "description": "The CSAT question the customer answered.",
            "type": "string",
            "example": "How did we do?"
          },
          "rating": {
            "description": "The customer's rating, from 1 to 5.",
            "type": "integer",
            "example": 5
          },
          "answer": {
            "description": "The customer's written feedback, if any.",
            "type": "string",
            "example": "Great",
            "nullable": true
          }
        },
        "required": [
          "question",
          "rating"
        ]
      },
