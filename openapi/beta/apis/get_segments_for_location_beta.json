    "schemas": {
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "SegmentResourceName": {
        "type": "string",
        "enum": [
          "segment"
        ]
      },
      "SegmentResponse": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Name of the segment.",
            "type": "string",
            "example": "Klaviyo Boston - within 10 miles"
          },
          "definition": {
            "description": "The segment's conditions, in the same format the segments API uses. Pass this back unchanged when creating a segment through `POST /api/segments`.",
            "type": "object",
            "nullable": true
          },
          "created": {
            "description": "Date and time when the segment was created, in ISO 8601 format.",
            "type": "string",
            "format": "date-time",
            "example": "2022-11-08T00:00:00+00:00",
            "nullable": true
          },
          "updated": {
            "description": "Date and time when the segment was last updated, in ISO 8601 format.",
            "type": "string",
            "format": "date-time",
            "example": "2022-11-08T00:00:00+00:00",
            "nullable": true
          },
          "linked_at": {
            "description": "Date and time when this segment was linked to the location, in ISO 8601 format.",
            "type": "string",
            "format": "date-time",
            "example": "2022-11-08T00:00:00+00:00",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "SegmentResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SegmentResourceName"
          },
          "id": {
            "description": "Primary key that uniquely identifies this segment.",
            "type": "string",
            "example": "01HQ8V5X9K2M4N6P8R0T2W4Y6A"
          },
          "attributes": {
            "$ref": "#/components/schemas/SegmentResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "SegmentResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SegmentResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
