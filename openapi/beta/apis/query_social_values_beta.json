    "schemas": {
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "SocialReportTimeframeRequest": {
        "type": "object",
        "properties": {
          "key": {
            "description": "Named preset window.",
            "type": "string",
            "example": "last_90_days",
            "enum": [
              "last_7_days",
              "last_30_days",
              "last_90_days",
              "month_to_date"
            ],
            "nullable": true
          },
          "start": {
            "description": "ISO-8601 lower-bound (inclusive) for the report window.",
            "type": "string",
            "format": "date-time",
            "example": "2026-08-07T00:00:00+00:00",
            "nullable": true
          },
          "end": {
            "description": "ISO-8601 upper-bound (exclusive) for the report window.",
            "type": "string",
            "format": "date-time",
            "example": "2026-08-14T00:00:00+00:00",
            "nullable": true
          }
        }
      },
      "SocialValuesData": {
        "type": "object",
        "properties": {
          "groupings": {
            "description": "Bucket-identifying values for this row. Empty when the request omits a dimension for a single account-level row. dimension=content rows also include 'posted_date' (YYYY-MM-DD) when available.",
            "type": "object",
            "example": {
              "content": "a2f90559e8e7471a92f17a3c8b62636e",
              "posted_date": "2026-08-15"
            }
          },
          "statistics": {
            "description": "Computed metrics for this row. Only the statistics named in the request appear here. A value is null when the aggregate has no data to report (e.g. no post reported a value) rather than being omitted.",
            "type": "object",
            "example": {
              "likes": 12,
              "views": 340,
              "engagement_rate": 0.83333
            }
          }
        },
        "required": [
          "groupings",
          "statistics"
        ]
      },
      "SocialValuesFilterRequest": {
        "type": "object",
        "properties": {
          "content_type": {
            "description": "Restrict dimension=content rows to owned or user_generated content. Ignored for every other dimension. Omit to rank across both.",
            "type": "string",
            "enum": [
              "owned",
              "user_generated"
            ],
            "nullable": true
          }
        }
      },
      "SocialValuesReportQueryRequest": {
        "type": "object",
        "properties": {
          "statistics": {
            "description": "Statistics to compute. Combine multiple in one call to receive all of them per row.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialValuesStatistic"
            },
            "example": [
              "likes",
              "views",
              "engagement_rate"
            ]
          },
          "timeframe": {
            "description": "Time window for the report.",
            "example": {
              "key": "last_90_days"
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/SocialReportTimeframeRequest"
              }
            ]
          },
          "dimension": {
            "description": "Optional breakdown dimension. Omit for a single account-level row. Not valid combined with any revenue statistic (engagement_revenue, auto_reply_revenue, social_revenue).",
            "type": "string",
            "example": "content",
            "enum": [
              "content",
              "creator",
              "auto_reply"
            ],
            "nullable": true
          },
          "filter": {
            "description": "Statistic-appropriate filters.",
            "allOf": [
              {
                "$ref": "#/components/schemas/SocialValuesFilterRequest"
              }
            ],
            "nullable": true
          },
          "sort": {
            "description": "Sort key when dimension is set; prefix '-' for descending. Ignored otherwise.",
            "type": "string",
            "nullable": true
          },
          "page_cursor": {
            "description": "Cursor for the next page of results.",
            "type": "string",
            "nullable": true
          },
          "page_size": {
            "description": "Rows per page. Only applies when dimension is set.",
            "type": "integer",
            "example": 20,
            "default": 20
          }
        },
        "required": [
          "statistics",
          "timeframe"
        ]
      },
      "SocialValuesReportQueryRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SocialValuesReportResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/SocialValuesReportQueryRequest"
          }
        },
        "required": [
          "type",
          "attributes"
        ]
      },
      "SocialValuesReportQueryRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SocialValuesReportQueryRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "SocialValuesReportResourceName": {
        "type": "string",
        "enum": [
          "social-values-report"
        ]
      },
      "SocialValuesReportResponse": {
        "type": "object",
        "properties": {
          "results": {
            "description": "Computed values-report rows.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialValuesData"
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "SocialValuesReportResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SocialValuesReportResourceName"
          },
          "id": {
            "description": "Opaque identifier for the values report response.",
            "type": "string",
            "example": "a2f90559-e8e7-471a-92f1-7a3c8b62636e"
          },
          "attributes": {
            "$ref": "#/components/schemas/SocialValuesReportResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "SocialValuesReportResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SocialValuesReportResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "SocialValuesStatistic": {
        "description": "Metrics computable for each social values-report row.",
        "type": "string",
        "enum": [
          "engagement_revenue",
          "auto_reply_revenue",
          "social_revenue",
          "views",
          "engagement_rate",
          "engagements_total",
          "followers",
          "follower_growth",
          "shares",
          "saves",
          "posts",
          "likes",
          "comments",
          "engagement_per_post",
          "tags_used",
          "funnel_started",
          "funnel_responded",
          "funnel_submitted_identifier",
          "funnel_ended",
          "completion_rate",
          "subscribers",
          "revenue"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Beta APIs",
      "description": "beta apis"
    }
  ]
}
