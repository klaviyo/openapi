                          }
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "ProfileResourceName": {
        "type": "string",
        "enum": [
          "profile"
        ]
      },
      "ServiceMessageResourceName": {
        "type": "string",
        "enum": [
          "service-message"
        ]
      },
      "ServiceMessageResponse": {
        "type": "object",
        "properties": {
          "author_type": {
            "description": "Who wrote the message.",
            "type": "string",
            "example": "human-agent",
            "enum": [
              "customer",
              "human-agent",
              "ai-agent",
              "automation"
            ]
          },
          "channel": {
            "description": "Channel the message was sent on.",
            "type": "string",
            "example": "email"
          },
          "content": {
            "description": "Message content.",
            "example": "Your order shipped today.",
            "type": "string"
          },
          "created_at": {
            "description": "Date and time when the message was sent.",
            "type": "string",
            "format": "date-time",
            "example": "2026-10-01T12:00:00+00:00"
          }
        },
        "required": [
          "author_type",
          "channel",
          "content",
          "created_at"
        ]
      },
      "ServiceMessageResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ServiceMessageResourceName"
          },
          "id": {
            "description": "Service message identifier.",
            "type": "string",
            "example": "48213907"
          },
          "attributes": {
            "$ref": "#/components/schemas/ServiceMessageResponse"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "service-ticket": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ServiceTicketResourceName"
                      },
                      "id": {
                        "description": "Ticket the message belongs to.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              },
              "profile": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ProfileResourceName"
                      },
                      "id": {
                        "description": "Klaviyo profile of the customer who wrote the message, if known.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              },
              "user": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/UserResourceName"
                      },
                      "id": {
                        "description": "Klaviyo user who wrote the message, for a support rep's message.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            },
            "required": [
              "service-ticket"
            ]
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "relationships",
          "links"
        ]
      },
      "ServiceMessageResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ServiceMessageResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "ServiceTicketResourceName": {
        "type": "string",
        "enum": [
          "service-ticket"
        ]
      },
      "UserResourceName": {
        "type": "string",
        "enum": [
          "user"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Beta APIs",
      "description": "beta apis"
    }
  ]
}
