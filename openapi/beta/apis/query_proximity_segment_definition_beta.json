    "schemas": {
      "LocationResourceName": {
        "type": "string",
        "enum": [
          "location"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "ProximitySegmentDefinitionQueryRequest": {
        "type": "object",
        "properties": {
          "radius": {
            "description": "Distance from the location that profiles must be within, in `unit`.",
            "type": "number",
            "example": 30,
            "default": 30
          },
          "unit": {
            "description": "Unit `radius` is measured in.",
            "type": "string",
            "example": "miles",
            "default": "miles",
            "enum": [
              "miles",
              "kilometers"
            ]
          }
        }
      },
      "ProximitySegmentDefinitionQueryRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ProximitySegmentDefinitionResourceName"
          },
          "attributes": {
            "$ref": "#/components/schemas/ProximitySegmentDefinitionQueryRequest"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/LocationResourceName"
                      },
                      "id": {
                        "description": "Identifier of the location to seed the definition from.",
                        "type": "string",
                        "example": "01HQ8V5X9K2M4N6P8R0T2W4Y6A"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            },
            "required": [
              "location"
            ]
          }
        },
        "required": [
          "type",
          "attributes",
          "relationships"
        ]
      },
      "ProximitySegmentDefinitionQueryRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProximitySegmentDefinitionQueryRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "ProximitySegmentDefinitionResourceName": {
        "type": "string",
        "enum": [
          "proximity-segment-definition"
        ]
      },
      "ProximitySegmentDefinitionResponse": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Suggested segment name, taken from the location's name.",
            "type": "string",
            "example": "Klaviyo Boston"
          },
          "definition": {
            "description": "The segment's conditions, in the same format the segments API uses. Pass this back unchanged when creating a segment through `POST /api/segments`.",
            "type": "object"
          }
        },
        "required": [
          "name",
          "definition"
        ]
      },
      "ProximitySegmentDefinitionResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ProximitySegmentDefinitionResourceName"
          },
          "id": {
            "description": "Identifier of the location this definition was seeded from.",
            "type": "string",
            "example": "01HQ8V5X9K2M4N6P8R0T2W4Y6A"
          },
          "attributes": {
            "$ref": "#/components/schemas/ProximitySegmentDefinitionResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "ProximitySegmentDefinitionResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProximitySegmentDefinitionResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
