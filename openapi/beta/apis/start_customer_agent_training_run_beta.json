                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "CustomerAgentResourceName": {
        "type": "string",
        "enum": [
          "customer-agent"
        ]
      },
      "CustomerAgentTrainingRunCreateRequestRequestData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CustomerAgentTrainingRunResourceName"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "customer-agent": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/CustomerAgentResourceName"
                      },
                      "id": {
                        "description": "Customer Agent to train. Use the ID returned by Get Customer Agents.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            },
            "required": [
              "customer-agent"
            ]
          }
        },
        "required": [
          "type",
          "relationships"
        ]
      },
      "CustomerAgentTrainingRunCreateRequestRequestDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CustomerAgentTrainingRunCreateRequestRequestData"
          }
        },
        "required": [
          "data"
        ]
      },
      "CustomerAgentTrainingRunResourceName": {
        "type": "string",
        "enum": [
          "customer-agent-training-run"
        ]
      },
      "CustomerAgentTrainingRunResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Training lifecycle status. Stop polling only when this is `succeeded` or `failed`, regardless of `stage`. Accounts that have never trained return `not_started`.",
            "type": "string",
            "enum": [
              "not_started",
              "pending",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "stage": {
            "description": "Current pipeline step. May be null during training; never use it to stop polling.",
            "type": "string",
            "enum": [
              "selecting_source",
              "importing_conversations",
              "clustering_conversations",
              "preparing_scenario_inputs",
              "generating_scenarios",
              "running_simulations",
              "complete"
            ],
            "nullable": true
          },
          "source": {
            "description": "Selected training corpus: `customer_agent`, `third_party_helpdesk`, or `canonical`. Null until selected.",
            "type": "string",
            "enum": [
              "customer_agent",
              "third_party_helpdesk",
              "canonical"
            ],
            "nullable": true
          },
          "error": {
            "description": "Customer-safe explanation when training did not finish, otherwise null.",
            "type": "string",
            "nullable": true
          },
          "started_at": {
            "description": "When the most recent training was requested. Null before the first run.",
            "type": "string",
            "format": "date-time",
            "example": "2022-11-08T00:00:00+00:00",
            "nullable": true
          }
        },
        "required": [
          "status"
        ]
      },
      "CustomerAgentTrainingRunResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CustomerAgentTrainingRunResourceName"
          },
          "id": {
            "description": "The account's ID.",
            "type": "string",
            "example": "AbC123"
          },
          "attributes": {
            "$ref": "#/components/schemas/CustomerAgentTrainingRunResponse"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
      },
      "CustomerAgentTrainingRunResponseDataWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CustomerAgentTrainingRunResponseData"
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "data"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
  "tags": [
    {
      "name": "Beta APIs",
      "description": "beta apis"
    }
  ]
}
