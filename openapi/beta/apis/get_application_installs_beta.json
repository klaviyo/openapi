      },
      "VideoLink": {
        "type": "object",
        "properties": {
          "video_id": {
            "description": "YouTube video ID.",
            "type": "string",
            "example": "dQw4w9WgXcQ"
          }
        },
        "required": [
          "video_id"
        ]
      }
