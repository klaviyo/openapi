    "schemas": {
      "AccountResourceName": {
        "type": "string",
        "enum": [
          "account"
        ]
      },
      "ApplicationCategoryEnum": {
        "description": "The marketplace category an application is listed under.\n\nEach member pairs its public value with the value the applications\n    backend stores for that category, so the two cannot drift apart.",
        "type": "string",
        "enum": [
          "accounting",
          "advertising",
          "cdp",
          "crm",
          "data_warehouse",
          "design_and_content",
          "direct_mail",
          "donations",
          "ecommerce_platform",
          "email_service_provider",
          "event_management",
          "fundraising",
          "health_and_wellness",
          "journey_optimization",
          "landing_pages_and_forms",
          "payments",
          "personalization",
          "pos",
          "project_management",
          "quizzes_and_surveys",
          "restaurants",
          "reviews",
          "rewards",
          "shipping",
          "smtp",
          "subscriptions",
          "support_and_help_desk",
          "travel",
          "workflow_automation"
        ]
      },
      "ApplicationFeature": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Feature title.",
            "type": "string",
            "example": "Recover Abandoned Carts"
          },
          "short_description": {
            "description": "Feature description.",
            "type": "string",
            "example": "Trigger custom abandoned cart email flows to recover lost sales."
          }
        },
        "required": [
          "title",
          "short_description"
        ]
      },
      "ApplicationInstallResourceName": {
        "type": "string",
        "enum": [
          "application-install"
        ]
      },
      "ApplicationInstallResponse": {
        "type": "object",
        "properties": {
          "installed_at": {
            "description": "ISO 8601 timestamp when the application was installed.",
            "type": "string",
            "format": "date-time",
            "example": "2026-03-04T00:00:00Z"
          }
        },
        "required": [
          "installed_at"
        ]
      },
      "ApplicationInstallResponseData": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ApplicationInstallResourceName"
          },
          "id": {
            "description": "The ID of the application install: the application ID and the account ID joined by a colon.",
            "type": "string",
            "example": "01HQXYZAPPULID000000000000:abc123"
          },
          "attributes": {
            "$ref": "#/components/schemas/ApplicationInstallResponse"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "application": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/ApplicationResourceName"
                      },
                      "id": {
                        "description": "The application that is installed.",
                        "type": "string",
                        "example": "01HQXYZAPPULID000000000000"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  },
                  "links": {
                    "$ref": "#/components/schemas/RelationshipLinks"
                  }
                }
              },
              "account": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/AccountResourceName"
                      },
                      "id": {
                        "description": "The account the application is installed in.",
                        "type": "string",
                        "example": "abc123"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  }
                }
              }
            },
            "required": [
              "application",
              "account"
            ]
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "relationships",
          "links"
        ]
      },
      "ApplicationInstallResponseDataListWrapper": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationInstallResponseData"
            }
          },
          "links": {
            "$ref": "#/components/schemas/CollectionLinks"
          },
          "included": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationResponseData"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "ApplicationResourceName": {
        "type": "string",
        "enum": [
          "application"
        ]
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Display name of the application.",
            "type": "string",
            "example": "29 Next"
          },
          "developed_by": {
            "description": "Display name of the developer that built the application.",
            "type": "string",
            "example": "29 Next"
          },
          "status": {
            "description": "Where the application sits in the marketplace listing lifecycle.",
            "type": "string",
            "example": "published",
            "enum": [
              "draft",
              "submitted_for_review",
              "published",
              "unpublished"
            ]
          },
          "icon_url": {
            "description": "URL of the application's icon image.",
            "type": "string",
            "example": "https://static.klaviyo.com/applications/01HQXYZ/icon.svg"
          },
          "install_url": {
            "description": "URL that begins the install flow for this application. Null when none has been set.",
            "type": "string",
            "example": "https://accounts.example.com/oauth/marketing/klaviyo",
            "nullable": true
          },
          "privacy_policy_link": {
            "description": "URL of the application's privacy policy.",
            "type": "string",
            "example": "https://example.com/privacy"
          },
          "categories": {
            "description": "Marketplace categories the application is listed under.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationCategoryEnum"
            },
            "example": [
              "ecommerce_platform"
            ]
          },
          "features": {
            "description": "Highlighted features of the application.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationFeature"
            },
            "example": [
              {
                "title": "Grow Your Email and SMS Lists",
                "short_description": "Automatically sync customers and their purchases to Klaviyo."
              }
            ]
          },
          "gallery_items": {
            "description": "Images shown in the application's media gallery.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GalleryItem"
            },
            "example": [
              {
                "image_url": "https://static.klaviyo.com/applications/01HQXYZ/gallery1.png"
              }
            ]
          },
          "articles": {
            "description": "User guides and case studies attached to the application.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Article"
            },
            "example": [
              {
                "type": "user_guide",
                "title": "Getting started",
                "link": "https://example.com/docs/getting-started",
                "description": "Step-by-step setup walkthrough."
              }
            ]
          },
          "client_id": {
            "description": "OAuth client ID of the application. Null when the application does not install through OAuth.",
            "type": "string",
            "example": "8b1a9953-c461-4a3f-9d2e-7c5f0e4b6a17",
            "nullable": true
          },
          "scopes": {
            "description": "API scopes the application requests when an account installs it. Empty when the application does not install through OAuth.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "events:read",
              "profiles:read"
            ],
            "default": []
          },
          "oauth_callback_urls": {
            "description": "OAuth redirect URIs registered for the application. Returned only to the account that owns the application, and null otherwise.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "https://example.com/oauth/callback"
            ],
            "nullable": true
          },
          "short_description": {
            "description": "One-line description of the application.",
            "type": "string",
            "example": "DTC ecommerce platform designed for performance-obsessed brands.",
            "nullable": true
          },
          "description": {
            "description": "Long-form description of the application.",
            "type": "string",
            "example": "29 Next helps DTC merchants unlock profitable growth.",
            "nullable": true
          },
          "banner_image_url": {
            "description": "URL of the application's banner image. Set on featured tiles.",
            "type": "string",
            "example": "https://static.klaviyo.com/applications/01HQXYZ/banner.png",
            "nullable": true
          },
          "preferences_link": {
            "description": "URL where end users manage the installed application.",
            "type": "string",
            "example": "https://example.com/manage",
            "nullable": true
          },
          "support_link": {
            "description": "How to contact the application's support team. Either an `https://` URL or a `mailto:` address.",
            "type": "string",
            "example": "https://example.com/support",
            "nullable": true
          },
          "website_link": {
            "description": "URL of the developer's website.",
            "type": "string",
            "example": "https://example.com",
            "nullable": true
          },
          "video": {
            "description": "YouTube video shown in the media gallery, when set.",
            "example": {
              "video_id": "dQw4w9WgXcQ"
            },
            "$ref": "#/components/schemas/VideoLink",
            "nullable": true
          },
          "pricing_information_link": {
            "description": "URL of the application's pricing information.",
            "type": "string",
            "example": "https://example.com/pricing",
            "nullable": true
          },
          "created_at": {
            "description": "ISO 8601 timestamp when the application was created.",
            "type": "string",
            "format": "date-time",
            "example": "2024-03-04T00:00:00Z",
            "nullable": true
          }
        },
        "required": [
          "name",
          "developed_by",
          "status",
          "icon_url",
          "privacy_policy_link",
          "categories",
          "features",
          "gallery_items",
          "articles"
        ]
      },
