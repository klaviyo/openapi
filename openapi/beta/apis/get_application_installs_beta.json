        ]
      },
      "GalleryItem": {
        "type": "object",
        "properties": {
          "image_url": {
            "description": "URL of the gallery image.",
            "type": "string",
            "example": "https://static.klaviyo.com/applications/01HQXYZ/gallery1.png"
          }
        },
        "required": [
          "image_url"
        ]
      },
      "ObjectLinks": {
