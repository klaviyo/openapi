      "ManagedDnsRecord": {
        "type": "object",
        "properties": {
          "host": {
            "description": "Relative DNS hostname within the delegated zone (`@` for apex).",
            "type": "string",
            "example": "@"
          },
          "type": {
            "description": "The DNS record type.",
            "type": "string",
            "enum": [
              "a",
              "aaaa",
              "caa",
              "cname",
              "mx",
              "ns",
              "soa",
              "txt"
            ]
          },
          "ttl": {
            "description": "Time to live in seconds.",
            "type": "integer",
            "example": 3600
          },
          "values": {
            "description": "Record values as stored in DNS Zone.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "\"yahoo-verification-key=abc\""
            ]
          },
          "locked": {
            "description": "Whether Klaviyo manages this record and it cannot be changed.",
            "type": "boolean"
          },
          "lock_reason": {
            "description": "Why the record is locked, when applicable.",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "host",
          "type",
          "ttl",
          "values",
          "locked"
        ]
      },
      "ManagedDnsRecordListJobEnum": {
        "type": "string",
        "enum": [
          "managed-dns-record-list-job"
        ]
      },
      "ManagedDnsRecordListJobResponseObjectResource": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ManagedDnsRecordListJobEnum"
          },
          "id": {
            "description": "The ID of the list job.",
            "type": "string",
            "example": "2040919"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "status": {
                "description": "The status of the list job.",
                "type": "string",
                "enum": [
                  "complete",
                  "failed",
                  "processing",
                  "queued"
                ]
              },
              "records": {
                "description": "DNS records in the zone when the job completes.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ManagedDnsRecord"
                },
                "nullable": true
              },
              "errors": {
                "description": "Failure message when the job status is failed.",
                "type": "string",
                "nullable": true
              },
              "error_code": {
                "description": "Machine-readable failure code when the job status is failed.",
                "type": "string",
                "enum": [
                  "record_locked",
                  "validation_error"
                ],
                "nullable": true
              }
            },
            "required": [
              "status"
            ]
          },
          "relationships": {
            "type": "object",
            "properties": {
              "sending-domain": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/SendingDomainEnum"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ]
                  },
                  "links": {
                    "$ref": "#/components/schemas/RelationshipLinks"
                  }
                }
              }
            }
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          }
        },
        "required": [
          "type",
          "id",
          "attributes",
          "links"
        ]
