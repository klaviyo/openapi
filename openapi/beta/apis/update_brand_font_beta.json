    "schemas": {
      "AgentHints": {
        "description": "Optional hints emitted by the API for agent callers",
        "type": "object",
        "properties": {
          "next_steps": {
            "description": "Suggested follow-up actions for agents to take after this response",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BrandFontEnum": {
        "type": "string",
        "enum": [
          "brand-font"
        ]
      },
      "BrandFontPartialUpdateQuery": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BrandFontPartialUpdateQueryResourceObject"
          }
        },
        "required": [
          "data"
        ]
      },
      "BrandFontPartialUpdateQueryResourceObject": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/BrandFontEnum"
          },
          "id": {
            "description": "The ID of the brand font.",
            "type": "string",
            "example": "google:42"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Human-readable name for this font. Cannot be null.",
                "type": "string",
                "example": "Headings",
                "nullable": true
              },
              "variants": {
                "description": "The Google font variants, replacing the current ones. Google fonts only; cannot be null or empty.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BrandFontVariant"
                },
                "nullable": true
              },
              "fallback": {
                "description": "The web-safe fallback font. Google fonts only; cannot be null.",
                "type": "string",
                "example": "helvetica",
                "enum": [
                  "arial",
                  "arial-black",
                  "century-gothic",
                  "comic-sans",
                  "courier",
                  "courier-new",
                  "geneva",
                  "georgia",
                  "helvetica",
                  "lucida",
                  "lucida-grande",
                  "lucida-sans",
                  "ms-serif",
                  "new-york",
                  "palatino",
                  "palatino-linotype",
                  "tahoma",
                  "times-new-roman",
                  "trebuchet-ms",
                  "verdana"
                ],
                "nullable": true
              }
            }
          }
        },
        "required": [
          "type",
          "id",
          "attributes"
        ]
      },
      "BrandFontVariant": {
        "type": "object",
        "properties": {
          "weight": {
            "description": "The font weight.",
            "type": "integer",
            "example": 400,
            "enum": [
              100,
              200,
              300,
              400,
              500,
              600,
              700,
              800,
              900
            ]
          },
          "style": {
            "description": "The font style.",
            "type": "string",
            "example": "normal",
            "enum": [
              "italic",
              "normal"
            ]
          }
        },
        "required": [
          "weight",
          "style"
        ]
      },
      "ObjectLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "self"
        ]
      },
      "PatchBrandFontResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/components/schemas/BrandFontEnum"
              },
              "id": {
                "description": "The ID of the brand font.",
                "type": "string",
                "example": "google:42"
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "font_type": {
                    "description": "The kind of font.",
                    "type": "string",
                    "example": "google",
                    "enum": [
                      "custom",
                      "google",
                      "typekit",
                      "websafe"
                    ]
                  },
                  "family": {
                    "description": "The font family name.",
                    "type": "string",
                    "example": "Barlow Condensed"
                  },
                  "name": {
                    "description": "Human-readable name for this font.",
                    "type": "string",
                    "example": "Barlow Condensed"
                  },
                  "font_family": {
                    "description": "The CSS font-family value to set as `font_family` in brand text styles to use this font.",
                    "type": "string",
                    "example": "'Barlow Condensed', Helvetica, Arial, sans-serif"
                  },
                  "fallback": {
                    "description": "The web-safe font used while this font loads or where it is unsupported. Null for web-safe fonts.",
                    "type": "string",
                    "example": "helvetica",
                    "enum": [
                      "arial",
                      "arial-black",
                      "century-gothic",
                      "comic-sans",
                      "courier",
                      "courier-new",
                      "geneva",
                      "georgia",
                      "helvetica",
                      "lucida",
                      "lucida-grande",
                      "lucida-sans",
                      "ms-serif",
                      "new-york",
                      "palatino",
                      "palatino-linotype",
                      "tahoma",
                      "times-new-roman",
                      "trebuchet-ms",
                      "verdana"
                    ],
                    "nullable": true
                  },
                  "variants": {
                    "description": "The weights and styles available for this font. Null for fonts without individually selectable variants.",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/BrandFontVariant"
                    },
                    "nullable": true
                  }
                },
                "required": [
                  "font_type",
                  "family",
                  "name",
                  "font_family"
                ]
              },
              "links": {
                "$ref": "#/components/schemas/ObjectLinks"
              }
            },
            "required": [
              "type",
              "id",
              "attributes",
              "links"
            ]
          },
          "links": {
            "$ref": "#/components/schemas/ObjectLinks"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data"
        ]
      },
      "ResponseMeta": {
        "description": "Response-level metadata",
        "type": "object",
        "properties": {
          "agent_hints": {
            "$ref": "#/components/schemas/AgentHints"
          }
        }
      }
    },
    "securitySchemes": {
      "Klaviyo-API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Private key authentication for /api/ endpoints is performed by setting the `Authorization` header to `Klaviyo-API-Key your-private-api-key`<br>For more information please visit https://developers.klaviyo.com/en/v2026-10-15.pre/reference/api-overview#authentication",
        "x-default": "Klaviyo-API-Key your-private-api-key"
      }
    }
  },
